{
    admin off
}

:80 {
    root * /app
    encode gzip

    @denied path /config* /lib* /tests* /vendor*
    @bootstrap path /vendor/twbs/bootstrap* /vendor/twbs/bootstrap-icons*
    handle @bootstrap { file_server }
    handle @denied { respond "Forbidden" 403 }

    @hidden path .* *.sql *.md *.log *.yaml *.yml
    handle @hidden { respond "Forbidden" 403 }

    @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
    handle @static {
        header Cache-Control "public, max-age=31536000"
        file_server
    }

    # API et routing : php_fastcgi remplace php_server
    @api path /api*
    handle @api {
        header Access-Control-Allow-Origin "*"
        rewrite * /index.php{uri}
        php_fastcgi 127.0.0.1:9000
    }

    # Routing général : php_fastcgi fait le try_files vers index.php tout seul
    php_fastcgi 127.0.0.1:9000
    file_server
}
